// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum userStatus {
  active
  inactive
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  name     String?
  sureName String?
  role     Role       @default(STUDENT)
  status   userStatus @default(active)

  // Relation ลิงก์ไปยังตารางเฉพาะทาง
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  courses        Course[]        @relation("TeacherCourses") // สำหรับครูผู้สอน
  enrollments    Enrollment[]
}

// 👩‍🏫 ตารางเก็บข้อมูลเฉพาะของครู
model TeacherProfile {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String // ภาควิชา เช่น Electrical Education
}

// 🧑‍🎓 ตารางเก็บข้อมูลเฉพาะของนักเรียน
model StudentProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String @unique // รหัสนักเรียน (ใส่เฉพาะตารางนี้ ครูจะไม่มีฟิลด์นี้แน่นอน)
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum statusClass {
  active
  upcoming
  complete
}

// 2. ตารางคลาสเรียน (Course)
model Course {
  id          String      @id @default(uuid())
  code        String      @unique
  className   String
  description String?
  teacherId   String
  roomId      String?
  maxStudents Int         @default(50)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      statusClass @default(upcoming)

  // Relation: เชื่อมโยงกลับไปหาครูผู้สอน
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  // Relation: รายชื่อนักเรียนที่อยู่ในคลาสนี้
  enrollments Enrollment[]
  tests       Test[]
}

model Test {
  id        String   @id @default(uuid())
  courseId  String
  testName  String
  testDate  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// 3. ตารางกลางสำหรับการจับคู่นักเรียนเข้าคลาส (Many-to-Many Enrollment)
model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId]) // ป้องกันไม่ให้นักเรียนคนเดิมลงซ้ำในคลาสเดิม
}
