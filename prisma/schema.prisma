// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum userStatus {
  active
  inactive
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  name     String?
  sureName String?
  role     Role       @default(STUDENT)
  status   userStatus @default(active)

  // Relation ลิงก์ไปยังตารางเฉพาะทาง
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  courses        Course[]        @relation("TeacherCourses") // สำหรับครูผู้สอน
  enrollments    Enrollment[]
  attempts       Attempt[]
  tests          Test[]          @relation("createdTests")
}

// 👩‍🏫 ตารางเก็บข้อมูลเฉพาะของครู
model TeacherProfile {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String // ภาควิชา เช่น Electrical Education
}

// 🧑‍🎓 ตารางเก็บข้อมูลเฉพาะของนักเรียน
model StudentProfile {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String @unique // รหัสนักเรียน (ใส่เฉพาะตารางนี้ ครูจะไม่มีฟิลด์นี้แน่นอน)
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum statusClass {
  active
  upcoming
  complete
}

// 2. ตารางคลาสเรียน (Course)
model Course {
  id          String      @id @default(uuid())
  code        String      @unique
  className   String
  description String?
  teacherId   String
  roomId      String?
  maxStudents Int         @default(50)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      statusClass @default(upcoming)

  // Relation: เชื่อมโยงกลับไปหาครูผู้สอน
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  // Relation: รายชื่อนักเรียนที่อยู่ในคลาสนี้
  enrollments Enrollment[]
  tests       Test[]
  syllabus    CourseSyllabus[]
}

model CourseSyllabus {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  week        Int      // สัปดาห์ที่
  title       String   // ชื่อหัวข้อ
  description String?  // คำอธิบายสั้น
  topics      String[] // รายการหัวข้อย่อย (Postgres array)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, week]) // 1 course มีแต่ละ week ได้แค่ 1 row
}

model Test {
  id       String @id @default(cuid())
  title    String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("createdTests", fields: [createdById], references: [id])

  durationMinutes Int      @default(45) // ระยะเวลาสอบ (นาที) กำหนดโดยครู/admin
  createdAt       DateTime @default(now())

  questions Question[]
  attempts  Attempt[]
}

// 3. ตารางกลางสำหรับการจับคู่นักเรียนเข้าคลาส (Many-to-Many Enrollment)
model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId]) // ป้องกันไม่ให้นักเรียนคนเดิมลงซ้ำในคลาสเดิม
}

model Attempt {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  testId String
  test   Test   @relation(fields: [testId], references: [id])

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?

  answers StudentAnswer[]
}

model Question {
  id     String @id @default(cuid())
  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  questionText String
  order        Int    @default(0) // ลำดับข้อ

  choices        Choice[]
  studentAnswers StudentAnswer[]
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  value     String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  studentAnswers StudentAnswer[]
}

model StudentAnswer {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  choiceId String
  choice   Choice @relation(fields: [choiceId], references: [id])
}
